{
  "version": 1,
  "default_flow": "heavy",
  "pre": { "role": "analysis" },
  "roles": {
    "analysis":     { "display": "需求分析", "order": 1, "artifact": "analysis.md",    "prompt_file": "prompts/analysis.md" },
    "proposal":     { "display": "产品方案", "order": 2, "artifact": "prd.md",         "prompt_file": "prompts/proposal.md" },
    "tech":         { "display": "技术方案", "order": 3, "artifact": "tech.md",        "prompt_file": "prompts/tech.md" },
    "tech_review":  { "display": "方案评审", "order": 4, "artifact": "tech_review.md", "prompt_file": "prompts/tech_review.md", "model": "" },
    "dev":          { "display": "需求开发", "order": 5, "artifact": null,             "prompt_file": "prompts/dev.md", "skills": ["browser-verify"] },
    "code_review":  { "display": "代码审查", "order": 6, "artifact": "code_review.md", "prompt_file": "prompts/code_review.md", "model": "" },
    "accept":       { "display": "测试验证", "order": 7, "artifact": "accept.md",      "prompt_file": "prompts/accept.md" },
    "merge_resolve":{ "display": "冲突解决", "order": 8, "artifact": null,             "prompt_file": "prompts/merge_resolve.md" }
  },
  "flows": [
    { "id": "quick", "name": "快速", "color": "green",
      "description": "极小改动：文案、配置值、提示词措辞、单文件样式微调，不改程序逻辑、不涉及长驻进程模块。只做开发与自测，不过代码审查与验收；改动触及项目声明的高风险路径会自动升级为标准流程。",
      "nodes": [
        { "role": "dev", "node_type": "code" },
        { "node_type": "terminal" } ] },
    { "id": "standard", "name": "标准", "color": "indigo",
      "description": "常规改动：不需要先出技术方案（改动面清楚、方案一眼可定，如单点修复、局部逻辑修改、界面与样式调整），改完需要跑一遍验证。开发完成后先过代码审查，再进验收。",
      "nodes": [
        { "role": "dev", "node_type": "code" },
        { "role": "code_review", "node_type": "review" },
        { "role": "accept", "node_type": "artifact" },
        { "node_type": "terminal" } ] },
    { "id": "heavy", "name": "复杂", "color": "fuchsia",
      "description": "需要先出技术方案的改动（有设计取舍或涉及多处改动），或高风险改动（跨仓库、动长驻进程/状态机/协议契约/并发与生命周期语义、数据迁移）。技术方案先过方案评审再进开发，开发完成后过代码审查再验收。",
      "nodes": [
        { "role": "tech", "node_type": "artifact" },
        { "role": "tech_review", "node_type": "review" },
        { "role": "dev", "node_type": "code" },
        { "role": "code_review", "node_type": "review" },
        { "role": "accept", "node_type": "artifact" },
        { "node_type": "terminal" } ] }
  ]
}
