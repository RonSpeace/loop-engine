# req-board 环境配置模板 —— 复制为 .env 使用（.env 已 gitignore，绝不入库）
# 消费方：scripts/run_local.sh / scripts/launchd-run.sh 启动时导出；飞书凭据见仓库根 feishu.json（设置抽屉 → 飞书机器人）

# ---- 模型（与 harness config.toml 的 default_model 全名对齐；不设则默认 deepseek/v4.1-flash）----
# KIMI_MODEL=deepseek/v4.1-flash

# ---- 按需覆盖（均有代码内默认值，通常不用设）----
# REQ_BOARD_PORT=8899          # 看板端口
# REQ_BOARD_ARTIFACTS=         # 产物根（默认 ~/.req-board/artifacts）
# REQ_BOARD_ARTIFACTS_LEGACY=  # #53 历史产物根（os.pathsep 分隔多根，只读兜底、当前根优先；空=关闭）
# REQ_BOARD_API=http://127.0.0.1:8899/api/requirements   # 调度器访问看板的地址
# KIMI_BIN=                    # kimi 二进制（默认：PATH 上的 kimi → ~/.kimi-code/bin/kimi）
# KIMI_CODE_HOME=              # 后台 agent harness home（默认 ~/.kimi-code-deepseek）
# REQ_BOARD_NO_FEISHU=1        # 显式跳过飞书（缺凭据时调度器自行降级）
